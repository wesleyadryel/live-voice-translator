{
  "manifest_version": 3,
  "name": "Live Voice Translator",
  "version": "0.9.0",
  "description": "Live two-way voice translation for browser conferences.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "tabCapture",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://telemost.yandex.ru/*",
    "https://telemost.yandex.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://telemost.yandex.ru/*", "https://telemost.yandex.com/*"],
      "js": ["src/conference-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://telemost.yandex.ru/*", "https://telemost.yandex.com/*"],
      "js": ["src/conference-content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/conference-content-module.js", "src/realtime.js"],
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://telemost.yandex.ru/*", "https://telemost.yandex.com/*"]
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Live Voice Translator",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "src/options.html"
}
